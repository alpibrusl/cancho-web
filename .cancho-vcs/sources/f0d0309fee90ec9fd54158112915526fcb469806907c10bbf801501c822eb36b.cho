module web;

// `web` -- declare an API once; get the router and the OpenAPI document from it.
//
// Before this module, `examples/users` said what its routes were three times: in
// the route table (`std.route`), in the `handle` dispatch that tests the id the
// router returns, and in a hand-written JSON string of OpenAPI `paths`. Nothing
// stopped the three disagreeing -- a route could be served and undocumented, or
// documented with a parameter the handler never read. Here an operation is
// declared once:
//
//     let (api, list) = web.operation(heap, api, "GET", "/users", "listUsers");
//     api = web.query_param(heap, api, list, "limit", limit_node, false);
//     api = web.respond(heap, api, list, 200, "a page", page_node);
//     api = web.respond_problem(heap, api, list, 422);
//
// `operation` registers the route in a `std.route` router and answers its id --
// the number `web.find` returns for a matching request, which the handler tests
// -- and everything declared after it about that id (parameters, the body, the
// responses) is what `web.openapi` writes. The schemas come from `cancho-schema`
// nodes, so a body that is validated and a body that is documented are one object.
//
// What this is not yet: it does not validate for the handler (a typed path
// parameter that fails is still a check the handler makes) and it does not
// dispatch -- the application keeps its loop and its `if` on the id
// (`docs/design.md` §2 says why the loop cannot be a callback). It is the
// declaration half of the layer, and the half that was written three times.
//
// Representation: a router, a text pool (every name, path and description,
// appended once), and one `Vec[Record]` of tagged records -- an `enum`, so a
// record's kind is a type and not the first int of a row of eight. Declaring is
// `O(1)` a call; `openapi` scans the records, which is start-up work on a few
// dozen of them.

import std.buffer;
import std.bytes;
import std.http;
import std.json;
import std.route;
import std.vec;
import schema;

pub res struct Api {
    router: route.Router,
    recs: vec.Vec[Record],
    text: buffer.Buffer,
    ops: int,
    // Two ints for each operation, in id order: where its record is in `recs`, and where its first parameter's is (-1 if
    // it has none; the parameters of one operation are a chain through the `next` of their records). So that `dispatch`
    // reads the parameters of one operation and not the whole declaration.
    index: vec.Vec[int],
}

// A parameter's place: the path, the query string, or a request header.
pub enum Where {
    Path,
    Query,
    Header,
}

// The two kinds of an operation's own words: its one-line `summary` and its longer `description`.
pub enum Words {
    Summary,
    Description,
}

// The eleven kinds of record, one variant each; what the first int of the row said before.
pub enum Record {
    Operation(OperationRec),
    Parameter(ParameterRec),
    Response(ResponseRec),
    Component(ComponentRec),
    Body(BodyRec),
    Scheme(SchemeRec),
    Security(SecurityRec),
    Default(DefaultRec),
    Words(WordsRec),
    Note(NoteRec),
    About(AboutRec),
}

pub struct OperationRec {
    path_at: int,
    path_len: int,
    method: int,
    id_at: int,
    id_len: int,
    documented: bool,
}

// `next` is the record index of the next parameter of the same operation, or -1 for the last one.
pub struct ParameterRec {
    op: int,
    place: Where,
    name_at: int,
    name_len: int,
    node: int,
    required: bool,
    next: int,
}

// `node` is -1 none, -2 the shared problem, -3 the shared error, -4 plain text; a schema node is 0 or more.
pub struct ResponseRec {
    op: int,
    status: int,
    text_at: int,
    text_len: int,
    node: int,
    header_at: int,
    header_len: int,
}

pub struct ComponentRec {
    name_at: int,
    name_len: int,
    node: int,
}

pub struct BodyRec {
    op: int,
    node: int,
    optional: bool,
}

pub struct SchemeRec {
    name_at: int,
    name_len: int,
    desc_at: int,
    desc_len: int,
}

// `scheme_len` is 0 when the record says the operation is open (`no_auth`).
pub struct SecurityRec {
    op: int,
    scheme_at: int,
    scheme_len: int,
}

pub struct DefaultRec {
    name_at: int,
    name_len: int,
}

pub struct WordsRec {
    op: int,
    kind: Words,
    text_at: int,
    text_len: int,
}

// A parameter's description: `name` is the parameter's, `text` the sentence written for it.
pub struct NoteRec {
    op: int,
    name_at: int,
    name_len: int,
    text_at: int,
    text_len: int,
}

pub struct AboutRec {
    kind: Words,
    text_at: int,
    text_len: int,
}

fn fill_rec() -> [] Record {
    return Record::About(AboutRec { kind: Words::Summary, text_at: 0, text_len: 0 });
}

pub fn empty[&h](heap: &!h Heap) -> [heap] Api {
    return Api { router: route.empty(heap), recs: vec.empty(heap, 64, fill_rec()), text: buffer.empty(heap, 512), ops: 0, index: vec.empty(heap, 16, 0) };
}

// End the API, answering how many operations it declared.
pub fn drop[&h](heap: &!h Heap, a: Api) -> [heap] int {
    let Api { router, recs, text, ops, index } = a;
    route.drop(heap, router);
    vec.drop(heap, recs);
    vec.drop(heap, index);
    buffer.drop(heap, text);
    return ops;
}

pub fn operation_count[&a](api: &a Api) -> [] int {
    return api.ops;
}

// ---------------------------------------------------------------------
// Declaring
// ---------------------------------------------------------------------

// `s` appended to the text pool: the pool and where it starts.
fn text_add[&h, &r](heap: &!h Heap, t: buffer.Buffer, s: &r [byte]) -> [heap] (buffer.Buffer, int) {
    var at = 0;
    borrow t as &tr in {
        at = buffer.size(tr);
    }
    return (buffer.append(heap, t, s), at);
}

// GET 0, POST 1, PUT 2, PATCH 3, DELETE 4; -1 for anything else.
fn method_code[&m](method: &m [byte]) -> [] int {
    if bytes.equal(method, "GET") {
        return 0;
    }
    if bytes.equal(method, "POST") {
        return 1;
    }
    if bytes.equal(method, "PUT") {
        return 2;
    }
    if bytes.equal(method, "PATCH") {
        return 3;
    }
    if bytes.equal(method, "DELETE") {
        return 4;
    }
    return 0 - 1;
}

fn method_key(code: int) -> [] &static [byte] {
    if code == 0 {
        return "get";
    }
    if code == 1 {
        return "post";
    }
    if code == 2 {
        return "put";
    }
    if code == 3 {
        return "patch";
    }
    return "delete";
}

fn declare[&h, &m, &p, &o](heap: &!h Heap, a: Api, method: &m [byte], pattern: &p [byte], operation_id: &o [byte], documented: bool) -> [heap] (Api, int) {
    let Api { router, recs, text, ops, index } = a;
    let code = method_code(method);
    if code < 0 {
        return (Api { router: router, recs: recs, text: text, ops: ops, index: index }, 0 - 1);
    }
    let id = ops + 1;
    let r = route.add(heap, router, method, pattern, id);
    let (t1, path_at) = text_add(heap, text, pattern);
    let (t2, name_at) = text_add(heap, t1, operation_id);
    var at = 0;
    borrow recs as &rr in {
        at = vec.size(rr);
    }
    let rc = vec.push(heap, recs, Record::Operation(OperationRec { path_at: path_at, path_len: len(pattern), method: code, id_at: name_at, id_len: len(operation_id), documented: documented }));
    let ix = vec.push(heap, vec.push(heap, index, at), 0 - 1);
    return (Api { router: r, recs: rc, text: t2, ops: id, index: ix }, id);
}

// A documented operation: routed, and written into the OpenAPI `paths`. Answers the
// api and the route id (`-1` and nothing registered for a method other than GET,
// POST, PUT, PATCH, DELETE). `pattern` is a `std.route` pattern (`/users/:id`); the
// document writes it as `/users/{id}`.
pub fn operation[&h, &m, &p, &o](heap: &!h Heap, a: Api, method: &m [byte], pattern: &p [byte], operation_id: &o [byte]) -> [heap] (Api, int) {
    return declare(heap, a, method, pattern, operation_id, true);
}

// A route that is served and deliberately not documented (the document itself).
pub fn internal[&h, &m, &p](heap: &!h Heap, a: Api, method: &m [byte], pattern: &p [byte]) -> [heap] (Api, int) {
    return declare(heap, a, method, pattern, "", false);
}

// `name` appended to the pool with its ASCII capitals lowered: `http.find_header` wants the name
// it is looking for in lowercase, and the declared spelling (`Idempotency-Key`) is what the
// document writes.
fn text_add_lower[&h, &r](heap: &!h Heap, t: buffer.Buffer, s: &r [byte]) -> [heap] (buffer.Buffer, int) {
    var at = 0;
    borrow t as &tr in {
        at = buffer.size(tr);
    }
    var out = t;
    var i = 0;
    while i < len(s) {
        var c = int_of(s[i]);
        if c >= 65 && c <= 90 {
            c = c + 32;
        }
        out = buffer.push(heap, out, byte_of(c));
        i = i + 1;
    }
    return (out, at);
}

fn param[&h, &n](heap: &!h Heap, a: Api, op: int, place: Where, name: &n [byte], node: int, required: bool) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, name);
    var pool = t;
    match place {
        Where::Header => {
            // Straight after the name, so that its place is the name's end (`dispatch` looks the header up by it).
            let (t2, low) = text_add_lower(heap, pool, name);
            pool = t2;
        }
        _ => {
        }
    }
    var here = 0;
    borrow recs as &rr in {
        here = vec.size(rr);
    }
    let rc = vec.push(heap, recs, Record::Parameter(ParameterRec { op: op, place: place, name_at: at, name_len: len(name), node: node, required: required, next: 0 - 1 }));
    var ix = index;
    var rd = rc;
    if op >= 1 && op <= ops {
        var first = 0 - 1;
        borrow ix as &ir in {
            first = vec.get(ir, 2 * (op - 1) + 1);
        }
        if first < 0 {
            borrow mut ix as &!iw in {
                vec.set(iw, 2 * (op - 1) + 1, here);
            }
        } else {
            var tail = first;
            var more = true;
            while more {
                var next = 0 - 1;
                borrow rd as &rr in {
                    let r = vec.get(rr, tail);
                    match r {
                        Record::Parameter(p) => {
                            next = p.next;
                        }
                        _ => {
                        }
                    }
                }
                if next < 0 {
                    more = false;
                } else {
                    tail = next;
                }
            }
            borrow mut rd as &!rw in {
                let r = vec.get(rw, tail);
                match r {
                    Record::Parameter(p) => {
                        vec.set(rw, tail, Record::Parameter(ParameterRec { op: p.op, place: p.place, name_at: p.name_at, name_len: p.name_len, node: p.node, required: p.required, next: here }));
                    }
                    _ => {
                    }
                }
            }
        }
    }
    return Api { router: router, recs: rd, text: pool, ops: ops, index: ix };
}

// A path parameter of the operation's path; `node` is its schema (an integer with a
// range, say). It is written once for the path, however many operations share it.
pub fn path_param[&h, &n](heap: &!h Heap, a: Api, op: int, name: &n [byte], node: int) -> [heap] Api {
    return param(heap, a, op, Where::Path, name, node, true);
}

pub fn query_param[&h, &n](heap: &!h Heap, a: Api, op: int, name: &n [byte], node: int, required: bool) -> [heap] Api {
    return param(heap, a, op, Where::Query, name, node, required);
}

// A request header of `op` (`Idempotency-Key`), documented as a header parameter. Not routed: the handler reads the header.
pub fn header_param[&h, &n](heap: &!h Heap, a: Api, op: int, name: &n [byte], node: int, required: bool) -> [heap] Api {
    return param(heap, a, op, Where::Header, name, node, required);
}

fn words[&h, &d](heap: &!h Heap, a: Api, op: int, kind: Words, what: &d [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, what);
    let rc = vec.push(heap, recs, Record::Words(WordsRec { op: op, kind: kind, text_at: at, text_len: len(what) }));
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// One line about `op`, written as its `summary`.
pub fn summary[&h, &d](heap: &!h Heap, a: Api, op: int, what: &d [byte]) -> [heap] Api {
    return words(heap, a, op, Words::Summary, what);
}

// A longer text about `op`, written as its `description`.
pub fn describe[&h, &d](heap: &!h Heap, a: Api, op: int, what: &d [byte]) -> [heap] Api {
    return words(heap, a, op, Words::Description, what);
}

// A description of the parameter called `name` (path, query or header, whichever `op` declared), written as its `description`.
pub fn describe_param[&h, &n, &d](heap: &!h Heap, a: Api, op: int, name: &n [byte], what: &d [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t1, name_at) = text_add(heap, text, name);
    let (t2, text_at) = text_add(heap, t1, what);
    let rc = vec.push(heap, recs, Record::Note(NoteRec { op: op, name_at: name_at, name_len: len(name), text_at: text_at, text_len: len(what) }));
    return Api { router: router, recs: rc, text: t2, ops: ops, index: index };
}

// The document's own words: `info.summary` and `info.description`. Either may be empty (it is then left out).
pub fn about[&h, &s, &d](heap: &!h Heap, a: Api, summary: &s [byte], description: &d [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t1, s_at) = text_add(heap, text, summary);
    let (t2, d_at) = text_add(heap, t1, description);
    let r1 = vec.push(heap, recs, Record::About(AboutRec { kind: Words::Summary, text_at: s_at, text_len: len(summary) }));
    let r2 = vec.push(heap, r1, Record::About(AboutRec { kind: Words::Description, text_at: d_at, text_len: len(description) }));
    return Api { router: router, recs: r2, text: t2, ops: ops, index: index };
}

// The request body of `op`, a JSON document matching schema node `node`.
pub fn body[&h](heap: &!h Heap, a: Api, op: int, node: int) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let rc = vec.push(heap, recs, Record::Body(BodyRec { op: op, node: node, optional: false }));
    return Api { router: router, recs: rc, text: text, ops: ops, index: index };
}

// The request body of `op` may be left out (`required: false`); when there is one it matches `node`.
pub fn optional_body[&h](heap: &!h Heap, a: Api, op: int, node: int) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let rc = vec.push(heap, recs, Record::Body(BodyRec { op: op, node: node, optional: true }));
    return Api { router: router, recs: rc, text: text, ops: ops, index: index };
}

fn response[&h, &d](heap: &!h Heap, a: Api, op: int, status: int, description: &d [byte], node: int) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, description);
    let rc = vec.push(heap, recs, Record::Response(ResponseRec { op: op, status: status, text_at: at, text_len: len(description), node: node, header_at: 0, header_len: 0 }));
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// A response of `op` with a JSON body matching `node`.
pub fn respond[&h, &d](heap: &!h Heap, a: Api, op: int, status: int, description: &d [byte], node: int) -> [heap] Api {
    return response(heap, a, op, status, description, node);
}

// A response with no body (a `204`).
pub fn respond_empty[&h, &d](heap: &!h Heap, a: Api, op: int, status: int, description: &d [byte]) -> [heap] Api {
    return response(heap, a, op, status, description, 0 - 1);
}

// A response with a plain-text body (`text/plain`, a string): a Prometheus exposition, say.
pub fn respond_text[&h, &d](heap: &!h Heap, a: Api, op: int, status: int, description: &d [byte]) -> [heap] Api {
    return response(heap, a, op, status, description, 0 - 4);
}

// A response that is the shared problem document (`components.responses.Problem`).
pub fn respond_problem[&h](heap: &!h Heap, a: Api, op: int, status: int) -> [heap] Api {
    return response(heap, a, op, status, "", 0 - 2);
}

// A response that is the shared error document (`components.responses.Error`), for an
// API whose errors are not `application/problem+json`: a component named `Error` is its
// schema, and it is written as `application/json`. The description is this status's own
// (a `$ref` may carry one in OpenAPI 3.1).
pub fn respond_error[&h, &d](heap: &!h Heap, a: Api, op: int, status: int, description: &d [byte]) -> [heap] Api {
    return response(heap, a, op, status, description, 0 - 3);
}

// A header, a string, on the latest response declared for `op` (a `Location`).
pub fn response_header[&h, &n](heap: &!h Heap, a: Api, op: int, name: &n [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, name);
    var rc = recs;
    var i = 0;
    borrow rc as &rr in {
        i = vec.size(rr) - 1;
    }
    var done = false;
    borrow mut rc as &!w in {
        while i >= 0 && !done {
            let r = vec.get(w, i);
            match r {
                Record::Response(resp) => {
                    if resp.op == op {
                        vec.set(w, i, Record::Response(ResponseRec { op: resp.op, status: resp.status, text_at: resp.text_at, text_len: resp.text_len, node: resp.node, header_at: at, header_len: len(name) }));
                        done = true;
                    }
                }
                _ => {
                }
            }
            i = i - 1;
        }
    }
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// Name a schema node a component: documents write a `$ref` to it where it is used,
// and list it under `components.schemas`. A component called `Problem` is also the
// target of `respond_problem`.
pub fn component[&h, &n](heap: &!h Heap, a: Api, name: &n [byte], node: int) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, name);
    let rc = vec.push(heap, recs, Record::Component(ComponentRec { name_at: at, name_len: len(name), node: node }));
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// ---------------------------------------------------------------------
// Who may call (declared here; `guard`, at the end of this file, checks it)
// ---------------------------------------------------------------------

// An HTTP bearer security scheme, listed under `components.securitySchemes`. `description`
// may be empty.
pub fn bearer_scheme[&h, &n, &d](heap: &!h Heap, a: Api, name: &n [byte], description: &d [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t1, name_at) = text_add(heap, text, name);
    let (t2, desc_at) = text_add(heap, t1, description);
    let rc = vec.push(heap, recs, Record::Scheme(SchemeRec { name_at: name_at, name_len: len(name), desc_at: desc_at, desc_len: len(description) }));
    return Api { router: router, recs: rc, text: t2, ops: ops, index: index };
}

// `op` may be called with `scheme`. Each call is one alternative (`security: [{a: []}, {b: []}]`:
// the caller needs one of them). An operation with no call inherits the document's default.
pub fn require[&h, &n](heap: &!h Heap, a: Api, op: int, scheme: &n [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, scheme);
    let rc = vec.push(heap, recs, Record::Security(SecurityRec { op: op, scheme_at: at, scheme_len: len(scheme) }));
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// `op` needs no credentials (`security: []`), whatever the document's default says.
pub fn no_auth[&h](heap: &!h Heap, a: Api, op: int) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let rc = vec.push(heap, recs, Record::Security(SecurityRec { op: op, scheme_at: 0, scheme_len: 0 }));
    return Api { router: router, recs: rc, text: text, ops: ops, index: index };
}

// The document's default security: each call is an alternative, as `require`.
pub fn default_require[&h, &n](heap: &!h Heap, a: Api, scheme: &n [byte]) -> [heap] Api {
    let Api { router, recs, text, ops, index } = a;
    let (t, at) = text_add(heap, text, scheme);
    let rc = vec.push(heap, recs, Record::Default(DefaultRec { name_at: at, name_len: len(scheme) }));
    return Api { router: router, recs: rc, text: t, ops: ops, index: index };
}

// ---------------------------------------------------------------------
// Asking who may call (read back from the declaration)
// ---------------------------------------------------------------------

// Whether `op` was declared open (`no_auth`), whatever the document's default says.
pub fn is_open[&a](api: &a Api, op: int) -> [] bool {
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Security(s) => {
                if s.op == op && s.scheme_len == 0 {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

fn own_alternatives[&a](api: &a Api, op: int) -> [] int {
    var n = 0;
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Security(s) => {
                if s.op == op && s.scheme_len > 0 {
                    n = n + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return n;
}

fn default_alternatives[&a](api: &a Api) -> [] int {
    var n = 0;
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Default(_) => {
                n = n + 1;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return n;
}

// How many alternatives `op` has, as the document writes them: its own `require` calls, or, if it made none, the document's
// `default_require` calls. 0: nothing is declared for it (and `is_open` is false unless it was declared open: an operation that is not
// open and has no alternative is one the document says nothing about, which a gate should not read as open). An operation that does not
// exist has 0.
pub fn requirements[&a](api: &a Api, op: int) -> [] int {
    if op < 1 || op > api.ops || is_open(api, op) {
        return 0;
    }
    let own = own_alternatives(api, op);
    if own > 0 {
        return own;
    }
    return default_alternatives(api);
}

// The scheme of the `i`-th alternative of `op` (0-based, in the order declared), or an empty text if there is none. A caller needs ONE of
// the alternatives. The text is the scheme's name as `bearer_scheme` was given it (`"admin"`).
pub fn requirement[&a](api: &a Api, op: int, i: int) -> [] &a [byte] {
    var seen = 0;
    var j = 0;
    if op < 1 || op > api.ops || i < 0 {
        return text_of(api, 0, 0);
    }
    if own_alternatives(api, op) > 0 && !is_open(api, op) {
        while j < vec.size(api.recs) {
            let r = vec.get(api.recs, j);
            match r {
                Record::Security(s) => {
                    if s.op == op && s.scheme_len > 0 {
                        if seen == i {
                            return text_of(api, s.scheme_at, s.scheme_len);
                        }
                        seen = seen + 1;
                    }
                }
                _ => {
                }
            }
            j = j + 1;
        }
        return text_of(api, 0, 0);
    }
    if is_open(api, op) {
        return text_of(api, 0, 0);
    }
    while j < vec.size(api.recs) {
        let r = vec.get(api.recs, j);
        match r {
            Record::Default(d) => {
                if seen == i {
                    return text_of(api, d.name_at, d.name_len);
                }
                seen = seen + 1;
            }
            _ => {
            }
        }
        j = j + 1;
    }
    return text_of(api, 0, 0);
}

// ---------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------

// The route id for a request, as `route.find`: the id `operation` answered, `-1`
// for no such path, `-2` for a path that exists under other methods (a 405).
pub fn find[&a, &m, &p, &t](api: &a Api, method: &m [byte], path: &p [byte], params: &!t [int]) -> [] int {
    return route.find(api.router, method, path, params);
}

pub fn allowed[&h, &a, &p, &t](heap: &!h Heap, api: &a Api, path: &p [byte], params: &!t [int], out: buffer.Buffer) -> [heap] buffer.Buffer {
    return route.allowed(heap, api.router, path, params, out);
}

// The widest parameter list any route has: the size a `params` table needs (x2).
pub fn most_params[&a](api: &a Api) -> [] int {
    return route.most_params(api.router);
}

// ---------------------------------------------------------------------
// Dispatch: the parameters of a request, judged by the nodes that document them
// ---------------------------------------------------------------------
//
// `docs/design.md` §9. `dispatch` is called in the application's own loop where `find` was; it
// is not a callback and keeps nothing. It answers the route id for a request whose declared
// path, query and header parameters are all valid, with their values in `args`, or it writes the
// whole answer itself (404, 405, 422) and answers `answered()`, so a handler is not reached
// for a request that breaks the contract.

// What `dispatch` answers when it has already written the answer to `out`.
pub fn answered() -> [] int {
    return 0 - 1;
}

// How many errors a 422 lists; past this they are counted, not stored (as `cancho-schema`'s `errs`).
fn most_reported() -> [] int {
    return 16;
}

// How many errors are counted at all. A query string is at most one request buffer, but each of
// its keys costs a scan of the operation's declared parameters, so the counting stops here.
fn most_counted() -> [] int {
    return 64;
}

// A code of this layer, beside `cancho-schema`'s: a declared query key given twice.
fn err_duplicate() -> [] int {
    return 100;
}

// The slot of the parameter `name` of operation `op`: its place among the parameters declared
// for `op`, in the order they were declared. -1 if there is none. Learned once at start-up, as
// the route id is; the slot is then `args[2 * slot]` and `args[2 * slot + 1]`.
pub fn slot[&a, &n](api: &a Api, op: int, name: &n [byte]) -> [] int {
    if op < 1 || op > api.ops {
        return 0 - 1;
    }
    var k = 0;
    var p = vec.get(api.index, 2 * (op - 1) + 1);
    while p >= 0 {
        var hit = false;
        let r = vec.get(api.recs, p);
        match r {
            Record::Parameter(par) => {
                if bytes.equal(text_of(api, par.name_at, par.name_len), name) {
                    hit = true;
                }
            }
            _ => {
            }
        }
        if hit {
            return k;
        }
        k = k + 1;
        var next = 0 - 1;
        match r {
            Record::Parameter(par) => {
                next = par.next;
            }
            _ => {
            }
        }
        p = next;
    }
    return 0 - 1;
}

// The size an `args` table needs: two ints for each parameter of the operation that declared the most.
pub fn most_args[&a](api: &a Api) -> [] int {
    var best = 1;
    var op = 1;
    while op <= api.ops {
        var n = 0;
        var p = vec.get(api.index, 2 * (op - 1) + 1);
        while p >= 0 {
            let r = vec.get(api.recs, p);
            var next = 0 - 1;
            match r {
                Record::Parameter(par) => {
                    n = n + 1;
                    next = par.next;
                }
                _ => {
                }
            }
            p = next;
        }
        if n > best {
            best = n;
        }
        op = op + 1;
    }
    return 2 * best;
}

// What a slot holds, by the kind of its node (`docs/design.md` §9.3): an integer is its value and
// 1 (0, 0 if absent); a bool is 0 or 1 and 1 (0, 0 if absent); anything else is the start and
// end of the value in the request head (-1, -1 if absent), where it stands as sent: still
// percent-encoded in a path or query.
pub fn int_arg[&g](args: &g [int], slot: int) -> [] int {
    return args[2 * slot];
}

pub fn bool_arg[&g](args: &g [int], slot: int) -> [] bool {
    return args[2 * slot] == 1;
}

pub fn present[&g](args: &g [int], slot: int) -> [] bool {
    return args[2 * slot + 1] > 0;
}

pub fn text_start[&g](args: &g [int], slot: int) -> [] int {
    return args[2 * slot];
}

pub fn text_end[&g](args: &g [int], slot: int) -> [] int {
    return args[2 * slot + 1];
}

// Which capture of the route pattern the path parameter `name` is: 0 for the first `:` or `*`
// segment, and so on; -1 if the pattern has no such parameter.
fn capture_index[&p, &n](pattern: &p [byte], name: &n [byte]) -> [] int {
    var i = 0;
    var c = 0;
    while i < len(pattern) {
        if int_of(pattern[i]) == 47 {
            let from = i + 1;
            var to = from;
            while to < len(pattern) && int_of(pattern[to]) != 47 {
                to = to + 1;
            }
            if to > from && (int_of(pattern[from]) == 58 || int_of(pattern[from]) == 42) {
                if bytes.equal(pattern[from + 1..to], name) {
                    return c;
                }
                c = c + 1;
            }
            i = to;
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

fn code_name_of(code: int) -> [] &static [byte] {
    if code == err_duplicate() {
        return "duplicate";
    }
    return schema.code_name(code);
}

fn code_message_of(code: int) -> [] &static [byte] {
    if code == err_duplicate() {
        return "is given more than once";
    }
    return schema.code_message(code);
}

// `name` as a JSON Pointer segment (RFC 6901 §3): `~` is `~0` and `/` is `~1`.
fn put_segment[&h, &n](heap: &!h Heap, out: buffer.Buffer, name: &n [byte]) -> [heap] buffer.Buffer {
    var b = out;
    var i = 0;
    while i < len(name) {
        let c = int_of(name[i]);
        if c == 126 {
            b = buffer.append(heap, b, "~0");
        } else if c == 47 {
            b = buffer.append(heap, b, "~1");
        } else {
            b = buffer.push(heap, b, name[i]);
        }
        i = i + 1;
    }
    return b;
}

// One entry of a 422's `errors`, appended to `eb`: where the parameter is (`/query/limit`,
// `/path/id`, `/header/Idempotency-Key`), the code a client switches on, and the sentence.
fn put_error[&h, &n](heap: &!h Heap, eb: buffer.Buffer, first: bool, place: int, name: &n [byte], code: int) -> [heap] buffer.Buffer {
    var ptr = buffer.empty(heap, 48);
    if place == 0 {
        ptr = buffer.append(heap, ptr, "/path/");
    } else if place == 1 {
        ptr = buffer.append(heap, ptr, "/query/");
    } else {
        ptr = buffer.append(heap, ptr, "/header/");
    }
    ptr = put_segment(heap, ptr, name);
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "pointer");
    borrow ptr as &pb in {
        w = json.put_string(heap, w, buffer.bytes(pb));
    }
    buffer.drop(heap, ptr);
    w = json.put_key(heap, w, "code");
    w = json.put_string(heap, w, code_name_of(code));
    w = json.put_key(heap, w, "detail");
    w = json.put_string(heap, w, code_message_of(code));
    w = json.end_object(heap, w);
    let item = json.finish(w);
    var b = eb;
    if !first {
        b = buffer.append(heap, b, ",");
    }
    borrow item as &ib in {
        b = buffer.append(heap, b, buffer.bytes(ib));
    }
    buffer.drop(heap, item);
    return b;
}

// The value a slot keeps for text that was judged good.
fn slot_value[&s, &t](sc: &s schema.Schema, node: int, text: &t [byte], from: int, to: int) -> [] (int, int) {
    if schema.is_int(sc, node) {
        return (schema.int_of_text(text), 1);
    }
    if schema.is_bool(sc, node) {
        if schema.bool_of_text(text) {
            return (1, 1);
        }
        return (0, 1);
    }
    return (from, to);
}

// Judge the parameter whose record is `i` (the `k`-th of its operation), writing its slot, and answer the code of what is wrong
// with it, or 0. `operation` is the operation's own record (it has the route pattern, which says which capture a path
// parameter is). Nothing here allocates.
fn check_param[&a, &s, &q, &t, &p, &g, &x](api: &a Api, sc: &s schema.Schema, i: int, operation: int, request: &q [byte], table: &t [int], params: &p [int], query: &q [byte], args: &!g [int], scratch: &!x [byte], k: int) -> [] int {
    let r = vec.get(api.recs, i);
    var place = Where::Path;
    var node = 0;
    var name_at = 0;
    var name_len = 0;
    var required = false;
    match r {
        Record::Parameter(par) => {
            place = par.place;
            node = par.node;
            name_at = par.name_at;
            name_len = par.name_len;
            required = par.required;
        }
        _ => {
        }
    }
    let name = text_of(api, name_at, name_len);
    var found = false;
    var from = 0;
    var to = 0;
    var twice = false;
    match place {
        Where::Path => {
            var pattern_at = 0;
            var pattern_len = 0;
            let ro = vec.get(api.recs, operation);
            match ro {
                Record::Operation(o) => {
                    pattern_at = o.path_at;
                    pattern_len = o.path_len;
                }
                _ => {
                }
            }
            let c = capture_index(text_of(api, pattern_at, pattern_len), name);
            if c >= 0 {
                found = true;
                from = table[1] + params[2 * c];
                to = table[1] + params[2 * c + 1];
            }
        }
        Where::Query => {
            let (qf, qt) = http.query_value(query, name);
            if qf >= 0 {
                found = true;
                from = table[3] + 1 + qf;
                to = table[3] + 1 + qt;
                let (rf, rt) = http.query_value(query[qt..len(query)], name);
                if rf >= 0 {
                    twice = true;
                }
            }
        }
        Where::Header => {
            let h = http.find_header(request, table, text_of(api, name_at + name_len, name_len));
            if h >= 0 {
                found = true;
                from = table[16 + 4 * h + 2];
                to = table[16 + 4 * h + 3];
            }
        }
    }
    var code = 0;
    var va = 0;
    var vb = 0;
    if !found {
        if !schema.is_int(sc, node) && !schema.is_bool(sc, node) {
            va = 0 - 1;
            vb = 0 - 1;
        }
        if required {
            code = schema.err_required();
        }
    } else if twice {
        code = err_duplicate();
    } else {
        var header = false;
        match place {
            Where::Header => {
                header = true;
            }
            _ => {
            }
        }
        if header {
            code = schema.check_text(sc, node, request[from..to]);
            if code == 0 {
                let (xa, xb) = slot_value(sc, node, request[from..to], from, to);
                va = xa;
                vb = xb;
            }
        } else {
            var plus_space = false;
            match place {
                Where::Query => {
                    plus_space = true;
                }
                _ => {
                }
            }
            // A path or query value is judged decoded; one too long for `scratch` is too long.
            let n = http.percent_decode(request[from..to], scratch, plus_space);
            if n < 0 {
                code = schema.err_type();
                if to - from > len(scratch) {
                    code = schema.err_max_length();
                }
            } else {
                code = schema.check_text(sc, node, scratch[0..n]);
                if code == 0 {
                    let (xa, xb) = slot_value(sc, node, scratch[0..n], from, to);
                    va = xa;
                    vb = xb;
                }
            }
        }
    }
    args[2 * k] = va;
    args[2 * k + 1] = vb;
    return code;
}

// The next key of `query`, from `start` on, that no declared query parameter of the operation (whose first parameter record is
// `first`) names: `(where it starts, where its name ends, where to look next)`, or `(-1, -1, -1)` if there is none. An empty pair,
// `a=1&&b=2`, is a key with no name and is unknown too.
fn next_unknown[&a, &q](api: &a Api, first: int, query: &q [byte], start: int) -> [] (int, int, int) {
    var at = start;
    while at < len(query) {
        var stop = at;
        while stop < len(query) && int_of(query[stop]) != 38 {
            stop = stop + 1;
        }
        var eq = at;
        while eq < stop && int_of(query[eq]) != 61 {
            eq = eq + 1;
        }
        var known = false;
        var j = first;
        while j >= 0 && !known {
            var is_query = false;
            var name_at = 0;
            var name_len = 0;
            var next = 0 - 1;
            let r = vec.get(api.recs, j);
            match r {
                Record::Parameter(par) => {
                    match par.place {
                        Where::Query => {
                            is_query = true;
                        }
                        _ => {
                        }
                    }
                    name_at = par.name_at;
                    name_len = par.name_len;
                    next = par.next;
                }
                _ => {
                }
            }
            if is_query && bytes.equal(query[at..eq], text_of(api, name_at, name_len)) {
                known = true;
            }
            j = next;
        }
        if !known {
            return (at, eq, stop + 1);
        }
        at = stop + 1;
    }
    return (0 - 1, 0 - 1, 0 - 1);
}

// Judge every declared parameter of `id`, filling `args`, and count the errors (at most `most_counted()`): one for each
// parameter that is required and absent, given twice, or not a value of its node, and one for each key of the query that the
// operation did not declare (an operation that declares no query parameter ignores the query string). The common answer is
// 0, and nothing here allocates.
fn judge[&a, &s, &q, &t, &p, &g, &x](api: &a Api, sc: &s schema.Schema, id: int, request: &q [byte], table: &t [int], params: &p [int], args: &!g [int], scratch: &!x [byte]) -> [] int {
    let query = http.query(request, table);
    let operation = vec.get(api.index, 2 * (id - 1));
    let first = vec.get(api.index, 2 * (id - 1) + 1);
    var errors = 0;
    var queried = false;
    var k = 0;
    var i = first;
    while i >= 0 {
        if check_param(api, sc, i, operation, request, table, params, query, args, scratch, k) != 0 && errors < most_counted() {
            errors = errors + 1;
        }
        let r = vec.get(api.recs, i);
        var is_query = false;
        var next = 0 - 1;
        match r {
            Record::Parameter(par) => {
                match par.place {
                    Where::Query => {
                        is_query = true;
                    }
                    _ => {
                    }
                }
                next = par.next;
            }
            _ => {
            }
        }
        if is_query {
            queried = true;
        }
        k = k + 1;
        i = next;
    }
    // Only an operation that declares some query parameter is closed, so the ones that never read the query keep ignoring it.
    var at = 0;
    while queried && errors < most_counted() && at >= 0 {
        let (ua, ue, resume) = next_unknown(api, first, query, at);
        if ua < 0 {
            at = 0 - 1;
        } else {
            errors = errors + 1;
            at = resume;
        }
    }
    return errors;
}

// `judge` again, for a request already known to break its declaration: the same errors, and the first `most_reported()` of them written
// into a new buffer as the entries of a 422's `errors`. Answers the buffer and the count.
fn explain[&h, &a, &s, &q, &t, &p, &g, &x](heap: &!h Heap, api: &a Api, sc: &s schema.Schema, id: int, request: &q [byte], table: &t [int], params: &p [int], args: &!g [int], scratch: &!x [byte]) -> [heap] (buffer.Buffer, int) {
    var b = buffer.empty(heap, 256);
    let query = http.query(request, table);
    let operation = vec.get(api.index, 2 * (id - 1));
    let first = vec.get(api.index, 2 * (id - 1) + 1);
    var errors = 0;
    var queried = false;
    var k = 0;
    var i = first;
    while i >= 0 {
        let code = check_param(api, sc, i, operation, request, table, params, query, args, scratch, k);
        if code != 0 && errors < most_counted() {
            if errors < most_reported() {
                var place = 0;
                let r = vec.get(api.recs, i);
                match r {
                    Record::Parameter(par) => {
                        match par.place {
                            Where::Path => {
                                place = 0;
                            }
                            Where::Query => {
                                place = 1;
                            }
                            Where::Header => {
                                place = 2;
                            }
                        }
                    }
                    _ => {
                    }
                }
                var name_at = 0;
                var name_len = 0;
                match r {
                    Record::Parameter(par) => {
                        name_at = par.name_at;
                        name_len = par.name_len;
                    }
                    _ => {
                    }
                }
                b = put_error(heap, b, errors == 0, place, text_of(api, name_at, name_len), code);
            }
            errors = errors + 1;
        }
        let r = vec.get(api.recs, i);
        var is_query = false;
        var next = 0 - 1;
        match r {
            Record::Parameter(par) => {
                match par.place {
                    Where::Query => {
                        is_query = true;
                    }
                    _ => {
                    }
                }
                next = par.next;
            }
            _ => {
            }
        }
        if is_query {
            queried = true;
        }
        k = k + 1;
        i = next;
    }
    var at = 0;
    while queried && errors < most_counted() && at >= 0 {
        let (ua, ue, resume) = next_unknown(api, first, query, at);
        if ua < 0 {
            at = 0 - 1;
        } else {
            if errors < most_reported() {
                b = put_error(heap, b, errors == 0, 1, query[ua..ue], schema.err_unknown());
            }
            errors = errors + 1;
            at = resume;
        }
    }
    return (b, errors);
}

// `{"type":"about:blank","title":..,"status":..,"detail":..}` as `application/problem+json`.
fn answer_problem_with[&h, &t, &d, &x](heap: &!h Heap, out: buffer.Buffer, status: int, title: &t [byte], detail: &d [byte], keep: bool, extra: &x [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "type");
    w = json.put_string(heap, w, "about:blank");
    w = json.put_key(heap, w, "title");
    w = json.put_string(heap, w, title);
    w = json.put_key(heap, w, "status");
    w = json.put_int(heap, w, status);
    w = json.put_key(heap, w, "detail");
    w = json.put_string(heap, w, detail);
    w = json.end_object(heap, w);
    let body = json.finish(w);
    var answer = out;
    borrow body as &bb in {
        answer = http.respond_head_with(heap, answer, status, "application/problem+json", len(buffer.bytes(bb)), keep, extra);
        answer = buffer.append(heap, answer, buffer.bytes(bb));
    }
    buffer.drop(heap, body);
    return answer;
}

fn answer_problem[&h, &t, &d](heap: &!h Heap, out: buffer.Buffer, status: int, title: &t [byte], detail: &d [byte], keep: bool) -> [heap] buffer.Buffer {
    return answer_problem_with(heap, out, status, title, detail, keep, "");
}

// The 422 for parameters: `count` errors found, `eb` the entries of the first of them.
fn answer_parameters[&h, &e](heap: &!h Heap, out: buffer.Buffer, count: int, eb: &e buffer.Buffer, keep: bool) -> [heap] buffer.Buffer {
    var body = buffer.append(heap, buffer.empty(heap, 256), "{\"type\":\"about:blank\",\"title\":\"Unprocessable Content\",\"status\":422,\"count\":");
    body = buffer.push_nat(heap, body, count);
    body = buffer.append(heap, body, ",\"errors\":[");
    body = buffer.append(heap, body, buffer.bytes(eb));
    body = buffer.append(heap, body, "]}");
    var answer = out;
    borrow body as &bb in {
        answer = http.respond_head_with(heap, answer, 422, "application/problem+json", len(buffer.bytes(bb)), keep, "");
        answer = buffer.append(heap, answer, buffer.bytes(bb));
    }
    buffer.drop(heap, body);
    return answer;
}

// The request's route and parameters, or the answer to a request that has neither a route nor
// valid parameters.
//
//   * `id >= 1`: the route matched and every declared parameter is valid; `args` holds them
//     (`slot`, `int_arg`, `present`, ...). `out` is untouched.
//   * `answered()`: `out` holds the whole answer, ready to send -- the 404 for no such path, the 405 with
//     `Allow`, or the 422 listing what was wrong. The handler does not run.
//
// `params` is the table `find` fills (`most_params` x 2 ints), `args` the table of values
// (`most_args`), `scratch` room to decode one value (a path or query value longer than it is
// `max_length`). All three are the caller's, allocated once.
pub fn dispatch[&h, &a, &s, &q, &t, &p, &g, &x](heap: &!h Heap, api: &a Api, sc: &s schema.Schema, request: &q [byte], table: &t [int], params: &!p [int], args: &!g [int], scratch: &!x [byte], out: buffer.Buffer, keep: bool) -> [heap] (buffer.Buffer, int) {
    let id = route.find(api.router, http.method(request, table), http.path(request, table), params);
    if id == 0 - 1 {
        return (answer_problem(heap, out, 404, "Not Found", "no such route", keep), answered());
    }
    if id == 0 - 2 {
        var extra = buffer.append(heap, buffer.empty(heap, 48), "Allow: ");
        extra = route.allowed(heap, api.router, http.path(request, table), params, extra);
        extra = buffer.append(heap, extra, "\r\n");
        let refusal = "{\"error\":\"method not allowed\"}";
        var answer = out;
        borrow extra as &eb in {
            answer = http.respond_head_with(heap, answer, 405, "application/json", len(refusal), keep, buffer.bytes(eb));
            answer = buffer.append(heap, answer, refusal);
        }
        buffer.drop(heap, extra);
        return (answer, answered());
    }
    if judge(api, sc, id, request, table, params, args, scratch) == 0 {
        return (out, id);
    }
    let (eb, count) = explain(heap, api, sc, id, request, table, params, args, scratch);
    var answer = out;
    borrow eb as &er in {
        answer = answer_parameters(heap, answer, count, er, keep);
    }
    buffer.drop(heap, eb);
    return (answer, answered());
}

// ---------------------------------------------------------------------
// The OpenAPI document
// ---------------------------------------------------------------------

fn text_of[&a](api: &a Api, at: int, n: int) -> [] &a [byte] {
    return buffer.bytes(api.text)[at..at + n];
}

// The record index of operation `op` (1-based), or -1: the index `operation` kept, not a scan of the records.
fn op_at[&a](api: &a Api, op: int) -> [] int {
    if op < 1 || op > api.ops {
        return 0 - 1;
    }
    return vec.get(api.index, 2 * (op - 1));
}

// Whether operations at records `i` and `j` have the same path.
fn same_path[&a](api: &a Api, i: int, j: int) -> [] bool {
    var ia = 0;
    var il = 0;
    let ri = vec.get(api.recs, i);
    match ri {
        Record::Operation(o) => {
            ia = o.path_at;
            il = o.path_len;
        }
        _ => {
        }
    }
    var ja = 0;
    var jl = 0;
    let rj = vec.get(api.recs, j);
    match rj {
        Record::Operation(o) => {
            ja = o.path_at;
            jl = o.path_len;
        }
        _ => {
        }
    }
    return bytes.equal(text_of(api, ia, il), text_of(api, ja, jl));
}

// The record index of the component whose schema is `node`, or -1.
fn comp_of[&a](api: &a Api, node: int) -> [] int {
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Component(c) => {
                if c.node == node {
                    return i;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn has_component[&a, &n](api: &a Api, name: &n [byte]) -> [] bool {
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Component(c) => {
                if bytes.equal(text_of(api, c.name_at, c.name_len), name) {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

// `"schema": ...` for `node`: a `$ref` if it is a component, else the generated JSON
// Schema inline.
fn put_schema[&h, &a, &s](heap: &!h Heap, w: json.Writer, api: &a Api, sc: &s schema.Schema, node: int) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "schema");
    let c = comp_of(api, node);
    if c >= 0 {
        o = json.begin_object(heap, o);
        o = json.put_key(heap, o, "$ref");
        var name_at = 0;
        var name_len = 0;
        let rc_rec = vec.get(api.recs, c);
        match rc_rec {
            Record::Component(comp) => {
                name_at = comp.name_at;
                name_len = comp.name_len;
            }
            _ => {
            }
        }
        var target = buffer.append(heap, buffer.empty(heap, 64), "#/components/schemas/");
        target = buffer.append(heap, target, text_of(api, name_at, name_len));
        borrow target as &tb in {
            o = json.put_string(heap, o, buffer.bytes(tb));
        }
        buffer.drop(heap, target);
        return json.end_object(heap, o);
    }
    let fragment = schema.json_schema(heap, sc, node);
    borrow fragment as &fb in {
        o = json.put_fragment(heap, o, buffer.bytes(fb));
    }
    buffer.drop(heap, fragment);
    return o;
}

// `/users/:id` as `/users/{id}`, `/files/*rest` as `/files/{rest}`.
fn put_path_key[&h, &p](heap: &!h Heap, w: json.Writer, pattern: &p [byte]) -> [heap] json.Writer {
    var out = buffer.empty(heap, 64);
    var in_param = false;
    var i = 0;
    while i < len(pattern) {
        let c = int_of(pattern[i]);
        if in_param && c == 47 {
            out = buffer.push(heap, out, byte_of(125));
            in_param = false;
        }
        if !in_param && (c == 58 || c == 42) {
            out = buffer.push(heap, out, byte_of(123));
            in_param = true;
        } else {
            out = buffer.push(heap, out, pattern[i]);
        }
        i = i + 1;
    }
    if in_param {
        out = buffer.push(heap, out, byte_of(125));
    }
    var o = w;
    borrow out as &ob in {
        o = json.put_key(heap, o, buffer.bytes(ob));
    }
    buffer.drop(heap, out);
    return o;
}

// The record of the description of the parameter named at `at`..`at + n` of operation `op`, or -1 (the last one declared wins).
fn note_of[&a](api: &a Api, op: int, at: int, n: int) -> [] int {
    var found = 0 - 1;
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Note(note) => {
                if note.op == op && bytes.equal(text_of(api, note.name_at, note.name_len), text_of(api, at, n)) {
                    found = i;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return found;
}

// The record of the `kind` words of operation `op`, or -1 (the last one declared wins).
fn words_of[&a](api: &a Api, op: int, kind: Words) -> [] int {
    var found = 0 - 1;
    var i = 0;
    while i < vec.size(api.recs) {
        let r = vec.get(api.recs, i);
        match r {
            Record::Words(words) => {
                var same = false;
                match kind {
                    Words::Summary => {
                        match words.kind {
                            Words::Summary => {
                                same = true;
                            }
                            Words::Description => {
                            }
                        }
                    }
                    Words::Description => {
                        match words.kind {
                            Words::Description => {
                                same = true;
                            }
                            Words::Summary => {
                            }
                        }
                    }
                }
                if words.op == op && same {
                    found = i;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return found;
}

// One parameter object: `{"name", "in", "required", "schema"}`.
fn put_param[&h, &a, &s](heap: &!h Heap, w: json.Writer, api: &a Api, sc: &s schema.Schema, i: int) -> [heap] json.Writer {
    var name_at = 0;
    var name_len = 0;
    var place = Where::Path;
    var required = false;
    var node = 0;
    var op = 0;
    let r = vec.get(api.recs, i);
    match r {
        Record::Parameter(par) => {
            name_at = par.name_at;
            name_len = par.name_len;
            place = par.place;
            required = par.required;
            node = par.node;
            op = par.op;
        }
        _ => {
        }
    }
    var o = json.begin_object(heap, w);
    o = json.put_key(heap, o, "name");
    o = json.put_string(heap, o, text_of(api, name_at, name_len));
    o = json.put_key(heap, o, "in");
    match place {
        Where::Path => {
            o = json.put_string(heap, o, "path");
        }
        Where::Query => {
            o = json.put_string(heap, o, "query");
        }
        Where::Header => {
            o = json.put_string(heap, o, "header");
        }
    }
    o = json.put_key(heap, o, "required");
    o = json.put_bool(heap, o, required);
    let n = note_of(api, op, name_at, name_len);
    if n >= 0 {
        o = json.put_key(heap, o, "description");
        var text_at = 0;
        var text_len = 0;
        let rn = vec.get(api.recs, n);
        match rn {
            Record::Note(note) => {
                text_at = note.text_at;
                text_len = note.text_len;
            }
            _ => {
            }
        }
        o = json.put_string(heap, o, text_of(api, text_at, text_len));
    }
    o = put_schema(heap, o, api, sc, node);
    return json.end_object(heap, o);
}

// Whether a path parameter named like the one at record `i` was already declared, by an
// operation with the path of operation record `first`, at an earlier record.
fn path_param_seen[&a](api: &a Api, first: int, i: int) -> [] bool {
    var i_at = 0;
    var i_len = 0;
    let ri = vec.get(api.recs, i);
    match ri {
        Record::Parameter(par) => {
            i_at = par.name_at;
            i_len = par.name_len;
        }
        _ => {
        }
    }
    var j = 0;
    while j < i {
        var is_path = false;
        var j_at = 0;
        var j_len = 0;
        var j_op = 0;
        let r = vec.get(api.recs, j);
        match r {
            Record::Parameter(par) => {
                match par.place {
                    Where::Path => {
                        is_path = true;
                    }
                    _ => {
                    }
                }
                j_at = par.name_at;
                j_len = par.name_len;
                j_op = par.op;
            }
            _ => {
            }
        }
        if is_path && bytes.equal(text_of(api, j_at, j_len), text_of(api, i_at, i_len)) {
            // declared earlier: by an operation of this same path?
            let owner = op_at(api, j_op);
            if owner >= 0 && same_path(api, first, owner) {
                return true;
            }
        }
        j = j + 1;
    }
    return false;
}

// `{"name": []}`, one alternative of a `security` array.
fn put_requirement[&h, &a](heap: &!h Heap, w: json.Writer, api: &a Api, at: int, n: int) -> [heap] json.Writer {
    var o = json.begin_object(heap, w);
    o = json.put_key(heap, o, text_of(api, at, n));
    o = json.begin_array(heap, o);
    o = json.end_array(heap, o);
    return json.end_object(heap, o);
}

fn put_operation[&h, &a, &s](heap: &!h Heap, w: json.Writer, api: &a Api, sc: &s schema.Schema, op: int, at: int) -> [heap] json.Writer {
    var id_at = 0;
    var id_len = 0;
    let r_at = vec.get(api.recs, at);
    match r_at {
        Record::Operation(operation) => {
            id_at = operation.id_at;
            id_len = operation.id_len;
        }
        _ => {
        }
    }
    var o = json.begin_object(heap, w);
    o = json.put_key(heap, o, "operationId");
    o = json.put_string(heap, o, text_of(api, id_at, id_len));
    let sum = words_of(api, op, Words::Summary);
    if sum >= 0 {
        o = json.put_key(heap, o, "summary");
        var text_at = 0;
        var text_len = 0;
        let rs = vec.get(api.recs, sum);
        match rs {
            Record::Words(words) => {
                text_at = words.text_at;
                text_len = words.text_len;
            }
            _ => {
            }
        }
        o = json.put_string(heap, o, text_of(api, text_at, text_len));
    }
    let desc = words_of(api, op, Words::Description);
    if desc >= 0 {
        o = json.put_key(heap, o, "description");
        var text_at = 0;
        var text_len = 0;
        let rd = vec.get(api.recs, desc);
        match rd {
            Record::Words(words) => {
                text_at = words.text_at;
                text_len = words.text_len;
            }
            _ => {
            }
        }
        o = json.put_string(heap, o, text_of(api, text_at, text_len));
    }
    var queries = 0;
    var i = 0;
    while i < vec.size(api.recs) {
        var is_param = false;
        var param_op = 0;
        var is_query = false;
        let r = vec.get(api.recs, i);
        match r {
            Record::Parameter(par) => {
                is_param = true;
                param_op = par.op;
                match par.place {
                    Where::Query => {
                        is_query = true;
                    }
                    Where::Header => {
                        is_query = true;
                    }
                    Where::Path => {
                    }
                }
            }
            _ => {
            }
        }
        if is_param && param_op == op && is_query {
            if queries == 0 {
                o = json.put_key(heap, o, "parameters");
                o = json.begin_array(heap, o);
            }
            o = put_param(heap, o, api, sc, i);
            queries = queries + 1;
        }
        i = i + 1;
    }
    if queries > 0 {
        o = json.end_array(heap, o);
    }
    i = 0;
    while i < vec.size(api.recs) {
        var is_body = false;
        var body_op = 0;
        var body_node = 0;
        var body_optional = false;
        let r = vec.get(api.recs, i);
        match r {
            Record::Body(b) => {
                is_body = true;
                body_op = b.op;
                body_node = b.node;
                body_optional = b.optional;
            }
            _ => {
            }
        }
        if is_body && body_op == op {
            o = json.put_key(heap, o, "requestBody");
            o = json.begin_object(heap, o);
            o = json.put_key(heap, o, "required");
            o = json.put_bool(heap, o, body_optional == false);
            o = json.put_key(heap, o, "content");
            o = json.begin_object(heap, o);
            o = json.put_key(heap, o, "application/json");
            o = json.begin_object(heap, o);
            o = put_schema(heap, o, api, sc, body_node);
            o = json.end_object(heap, o);
            o = json.end_object(heap, o);
            o = json.end_object(heap, o);
        }
        i = i + 1;
    }
    var open = false;
    var alternatives = 0;
    i = 0;
    while i < vec.size(api.recs) {
        var is_sec = false;
        var sec_op = 0;
        var sec_len = 0;
        let r = vec.get(api.recs, i);
        match r {
            Record::Security(sec) => {
                is_sec = true;
                sec_op = sec.op;
                sec_len = sec.scheme_len;
            }
            _ => {
            }
        }
        if is_sec && sec_op == op {
            if sec_len == 0 {
                open = true;
            } else {
                alternatives = alternatives + 1;
            }
        }
        i = i + 1;
    }
    if open || alternatives > 0 {
        o = json.put_key(heap, o, "security");
        o = json.begin_array(heap, o);
        if !open {
            i = 0;
            while i < vec.size(api.recs) {
                var is_sec = false;
                var sec_op = 0;
                var sec_at = 0;
                var sec_len = 0;
                let r = vec.get(api.recs, i);
                match r {
                    Record::Security(sec) => {
                        is_sec = true;
                        sec_op = sec.op;
                        sec_at = sec.scheme_at;
                        sec_len = sec.scheme_len;
                    }
                    _ => {
                    }
                }
                if is_sec && sec_op == op {
                    o = put_requirement(heap, o, api, sec_at, sec_len);
                }
                i = i + 1;
            }
        }
        o = json.end_array(heap, o);
    }
    o = json.put_key(heap, o, "responses");
    o = json.begin_object(heap, o);
    i = 0;
    while i < vec.size(api.recs) {
        var is_resp = false;
        var resp_op = 0;
        var resp_status = 0;
        var resp_text_at = 0;
        var resp_text_len = 0;
        var resp_node = 0;
        var resp_header_at = 0;
        var resp_header_len = 0;
        let r = vec.get(api.recs, i);
        match r {
            Record::Response(resp) => {
                is_resp = true;
                resp_op = resp.op;
                resp_status = resp.status;
                resp_text_at = resp.text_at;
                resp_text_len = resp.text_len;
                resp_node = resp.node;
                resp_header_at = resp.header_at;
                resp_header_len = resp.header_len;
            }
            _ => {
            }
        }
        if is_resp && resp_op == op {
            var status = buffer.push_nat(heap, buffer.empty(heap, 8), resp_status);
            borrow status as &sb in {
                o = json.put_key(heap, o, buffer.bytes(sb));
            }
            buffer.drop(heap, status);
            o = json.begin_object(heap, o);
            let node = resp_node;
            if node == 0 - 2 {
                o = json.put_key(heap, o, "$ref");
                o = json.put_string(heap, o, "#/components/responses/Problem");
            } else if node == 0 - 3 {
                o = json.put_key(heap, o, "$ref");
                o = json.put_string(heap, o, "#/components/responses/Error");
                o = json.put_key(heap, o, "description");
                o = json.put_string(heap, o, text_of(api, resp_text_at, resp_text_len));
            } else {
                o = json.put_key(heap, o, "description");
                o = json.put_string(heap, o, text_of(api, resp_text_at, resp_text_len));
                if resp_header_len > 0 {
                    o = json.put_key(heap, o, "headers");
                    o = json.begin_object(heap, o);
                    o = json.put_key(heap, o, text_of(api, resp_header_at, resp_header_len));
                    o = json.begin_object(heap, o);
                    o = json.put_key(heap, o, "schema");
                    o = json.begin_object(heap, o);
                    o = json.put_key(heap, o, "type");
                    o = json.put_string(heap, o, "string");
                    o = json.end_object(heap, o);
                    o = json.end_object(heap, o);
                    o = json.end_object(heap, o);
                }
                if node == 0 - 4 {
                    o = json.put_key(heap, o, "content");
                    o = json.put_fragment(heap, o, "{\"text/plain\":{\"schema\":{\"type\":\"string\"}}}");
                }
                if node >= 0 {
                    o = json.put_key(heap, o, "content");
                    o = json.begin_object(heap, o);
                    o = json.put_key(heap, o, "application/json");
                    o = json.begin_object(heap, o);
                    o = put_schema(heap, o, api, sc, node);
                    o = json.end_object(heap, o);
                    o = json.end_object(heap, o);
                }
            }
            o = json.end_object(heap, o);
        }
        i = i + 1;
    }
    o = json.end_object(heap, o);
    return json.end_object(heap, o);
}

// `"paths": { ... }`: each distinct path of a documented operation once, in the order
// the paths first appear, with its path parameters and then its operations in the order
// they were declared.
fn put_paths[&h, &a, &s](heap: &!h Heap, w: json.Writer, api: &a Api, sc: &s schema.Schema) -> [heap] json.Writer {
    var o = json.put_key(heap, w, "paths");
    o = json.begin_object(heap, o);
    var i = 0;
    while i < vec.size(api.recs) {
        var i_is_op = false;
        var i_documented = false;
        var i_path_at = 0;
        var i_path_len = 0;
        let ri = vec.get(api.recs, i);
        match ri {
            Record::Operation(op_rec) => {
                i_is_op = true;
                i_documented = op_rec.documented;
                i_path_at = op_rec.path_at;
                i_path_len = op_rec.path_len;
            }
            _ => {
            }
        }
        if i_is_op {
            var first = true;
            var j = 0;
            while j < i {
                var j_is_op = false;
                var j_documented = false;
                let rj = vec.get(api.recs, j);
                match rj {
                    Record::Operation(op_rec) => {
                        j_is_op = true;
                        j_documented = op_rec.documented;
                    }
                    _ => {
                    }
                }
                if j_is_op && j_documented && same_path(api, i, j) {
                    first = false;
                }
                j = j + 1;
            }
            if i_documented && first {
                o = put_path_key(heap, o, text_of(api, i_path_at, i_path_len));
                o = json.begin_object(heap, o);

                // the path's parameters, once each, whichever operation declared them
                var wrote = 0;
                var k = 0;
                while k < vec.size(api.recs) {
                    var k_is_path = false;
                    var k_op = 0;
                    let rk = vec.get(api.recs, k);
                    match rk {
                        Record::Parameter(par) => {
                            match par.place {
                                Where::Path => {
                                    k_is_path = true;
                                }
                                _ => {
                                }
                            }
                            k_op = par.op;
                        }
                        _ => {
                        }
                    }
                    if k_is_path {
                        let owner = op_at(api, k_op);
                        if owner >= 0 && same_path(api, i, owner) && !path_param_seen(api, i, k) {
                            if wrote == 0 {
                                o = json.put_key(heap, o, "parameters");
                                o = json.begin_array(heap, o);
                            }
                            o = put_param(heap, o, api, sc, k);
                            wrote = wrote + 1;
                        }
                    }
                    k = k + 1;
                }
                if wrote > 0 {
                    o = json.end_array(heap, o);
                }

                // its operations
                var m = 0;
                var m_op = 0;
                while m < vec.size(api.recs) {
                    var m_is_op = false;
                    var m_documented = false;
                    var m_method = 0;
                    let rm = vec.get(api.recs, m);
                    match rm {
                        Record::Operation(op_rec) => {
                            m_is_op = true;
                            m_documented = op_rec.documented;
                            m_method = op_rec.method;
                        }
                        _ => {
                        }
                    }
                    if m_is_op {
                        m_op = m_op + 1;
                        if m_documented && same_path(api, i, m) {
                            o = json.put_key(heap, o, method_key(m_method));
                            o = put_operation(heap, o, api, sc, m_op, m);
                        }
                    }
                    m = m + 1;
                }
                o = json.end_object(heap, o);
            }
        }
        i = i + 1;
    }
    return json.end_object(heap, o);
}

fn problem_response_json() -> [] &static [byte] {
    return "{\"description\":\"a problem\",\"content\":{\"application/problem+json\":{\"schema\":{\"$ref\":\"#/components/schemas/Problem\"}}}}";
}

fn error_response_json() -> [] &static [byte] {
    return "{\"description\":\"an error\",\"content\":{\"application/json\":{\"schema\":{\"$ref\":\"#/components/schemas/Error\"}}}}";
}

fn has_default[&a](api: &a Api) -> [] bool {
    var i = 0;
    while i < vec.size(api.recs) {
        match vec.get(api.recs, i) {
            Record::Default(_) => {
                return true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

fn has_scheme[&a](api: &a Api) -> [] bool {
    var i = 0;
    while i < vec.size(api.recs) {
        match vec.get(api.recs, i) {
            Record::Scheme(_) => {
                return true;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

// The document: OpenAPI 3.1, `info`, `paths` from the declared operations, and
// `components` -- the shared problem response (if a component is named `Problem`) and
// every component's schema, generated by `cancho-schema` from the nodes the
// application validates with.
pub fn openapi[&h, &a, &s, &t, &v](heap: &!h Heap, api: &a Api, sc: &s schema.Schema, title: &t [byte], version: &v [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 8192);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "openapi");
    w = json.put_string(heap, w, "3.1.0");
    w = json.put_key(heap, w, "info");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "title");
    w = json.put_string(heap, w, title);
    w = json.put_key(heap, w, "version");
    w = json.put_string(heap, w, version);
    var ab = 0;
    while ab < vec.size(api.recs) {
        let r = vec.get(api.recs, ab);
        match r {
            Record::About(about) => {
                if about.text_len > 0 {
                    match about.kind {
                        Words::Summary => {
                            w = json.put_key(heap, w, "summary");
                        }
                        Words::Description => {
                            w = json.put_key(heap, w, "description");
                        }
                    }
                    w = json.put_string(heap, w, text_of(api, about.text_at, about.text_len));
                }
            }
            _ => {
            }
        }
        ab = ab + 1;
    }
    w = json.end_object(heap, w);
    if has_default(api) {
        w = json.put_key(heap, w, "security");
        w = json.begin_array(heap, w);
        var d = 0;
        while d < vec.size(api.recs) {
            match vec.get(api.recs, d) {
                Record::Default(def) => {
                    w = put_requirement(heap, w, api, def.name_at, def.name_len);
                }
                _ => {
                }
            }
            d = d + 1;
        }
        w = json.end_array(heap, w);
    }
    w = put_paths(heap, w, api, sc);
    w = json.put_key(heap, w, "components");
    w = json.begin_object(heap, w);
    if has_component(api, "Problem") || has_component(api, "Error") {
        w = json.put_key(heap, w, "responses");
        w = json.begin_object(heap, w);
        if has_component(api, "Problem") {
            w = json.put_key(heap, w, "Problem");
            w = json.put_fragment(heap, w, problem_response_json());
        }
        if has_component(api, "Error") {
            w = json.put_key(heap, w, "Error");
            w = json.put_fragment(heap, w, error_response_json());
        }
        w = json.end_object(heap, w);
    }
    if has_scheme(api) {
        w = json.put_key(heap, w, "securitySchemes");
        w = json.begin_object(heap, w);
        var k = 0;
        while k < vec.size(api.recs) {
            match vec.get(api.recs, k) {
                Record::Scheme(sch) => {
                    w = json.put_key(heap, w, text_of(api, sch.name_at, sch.name_len));
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "type");
                    w = json.put_string(heap, w, "http");
                    w = json.put_key(heap, w, "scheme");
                    w = json.put_string(heap, w, "bearer");
                    if sch.desc_len > 0 {
                        w = json.put_key(heap, w, "description");
                        w = json.put_string(heap, w, text_of(api, sch.desc_at, sch.desc_len));
                    }
                    w = json.end_object(heap, w);
                }
                _ => {
                }
            }
            k = k + 1;
        }
        w = json.end_object(heap, w);
    }
    w = json.put_key(heap, w, "schemas");
    w = json.begin_object(heap, w);
    var i = 0;
    while i < vec.size(api.recs) {
        match vec.get(api.recs, i) {
            Record::Component(comp) => {
                w = json.put_key(heap, w, text_of(api, comp.name_at, comp.name_len));
                let fragment = schema.json_schema(heap, sc, comp.node);
                borrow fragment as &fb in {
                    w = json.put_fragment(heap, w, buffer.bytes(fb));
                }
                buffer.drop(heap, fragment);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    w = json.end_object(heap, w);
    w = json.end_object(heap, w);
    w = json.end_object(heap, w);
    return json.finish(w);
}

// ---------------------------------------------------------------------
// Who may call, enforced (`docs/design.md` §11)
// ---------------------------------------------------------------------
//
// `guard` is the check of the sentence the document already says: "a caller needs one of these
// alternatives". It is called in the application's loop after `dispatch`, before the handler. The
// credentials are data (`Tokens`: pairs of a scheme's name and a secret), because a verifier cannot
// be a callback (§2). Anything richer than a table of secrets is the application's, with `bearer`
// and the two writers below.

// The secrets the service accepts, each belonging to one scheme (`bearer_scheme`'s name).
pub res struct Tokens {
    text: buffer.Buffer,
    // Four ints per secret: where its scheme's name is in `text`, that name's length, where the secret is, its length.
    ents: vec.Vec[int],
}

pub fn tokens_empty[&h](heap: &!h Heap) -> [heap] Tokens {
    return Tokens { text: buffer.empty(heap, 64), ents: vec.empty(heap, 8, 0) };
}

pub fn tokens_drop[&h](heap: &!h Heap, t: Tokens) -> [heap] int {
    let Tokens { text, ents } = t;
    buffer.drop(heap, text);
    vec.drop(heap, ents);
    return 0;
}

// `secret` is accepted for the scheme called `scheme`. The same secret may be added for several schemes.
pub fn token[&h, &s, &x](heap: &!h Heap, t: Tokens, scheme: &s [byte], secret: &x [byte]) -> [heap] Tokens {
    let Tokens { text, ents } = t;
    let (t1, scheme_at) = text_add(heap, text, scheme);
    let (tx, secret_at) = text_add(heap, t1, secret);
    var e = vec.push(heap, ents, scheme_at);
    e = vec.push(heap, e, len(scheme));
    e = vec.push(heap, e, secret_at);
    e = vec.push(heap, e, len(secret));
    return Tokens { text: tx, ents: e };
}

fn lower_byte(c: int) -> [] int {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

// The secret of an `Authorization: Bearer <secret>` header, or an empty text if there is none, it is another scheme, or the
// secret is empty. The word `Bearer` is case-insensitive and one or more spaces follow it (RFC 9110 §11.1); trailing spaces and
// tabs are not part of the secret.
pub fn bearer[&q, &t](request: &q [byte], table: &t [int]) -> [] &q [byte] {
    let v = http.header(request, table, "authorization");
    var at = 0;
    if len(v) < 8 {
        return v[0..0];
    }
    let word = "bearer";
    while at < 6 {
        if lower_byte(int_of(v[at])) != int_of(word[at]) {
            return v[0..0];
        }
        at = at + 1;
    }
    if int_of(v[6]) != 32 {
        return v[0..0];
    }
    while at < len(v) && int_of(v[at]) == 32 {
        at = at + 1;
    }
    var end = len(v);
    while end > at && (int_of(v[end - 1]) == 32 || int_of(v[end - 1]) == 9) {
        end = end - 1;
    }
    return v[at..end];
}

// 401: no credential, or none that is known (`invalid`).
pub fn unauthorized[&h](heap: &!h Heap, out: buffer.Buffer, keep: bool, invalid: bool) -> [heap] buffer.Buffer {
    if invalid {
        return answer_problem_with(heap, out, 401, "Unauthorized", "the bearer token is not valid", keep, "WWW-Authenticate: Bearer error=\"invalid_token\"\r\n");
    }
    return answer_problem_with(heap, out, 401, "Unauthorized", "send Authorization: Bearer <token>", keep, "WWW-Authenticate: Bearer\r\n");
}

// 403: a known credential that does not open this operation.
pub fn forbidden[&h](heap: &!h Heap, out: buffer.Buffer, keep: bool) -> [heap] buffer.Buffer {
    return answer_problem_with(heap, out, 403, "Forbidden", "this token may not call this operation", keep, "WWW-Authenticate: Bearer error=\"insufficient_scope\"\r\n");
}

// Whether `name` is one of the schemes `op` lists.
fn lists_scheme[&a, &n](api: &a Api, op: int, name: &n [byte]) -> [] bool {
    var i = 0;
    let n = requirements(api, op);
    while i < n {
        if bytes.equal(requirement(api, op, i), name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Whether two secrets are the same. Every byte of `x` is looked at whatever the outcome, with no branch on the data; this is not
// a claim of constant time (the lengths differ, and the language does not promise it).
fn same_secret[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    var diff = 0;
    if len(x) != len(y) {
        diff = 1;
    }
    var i = 0;
    var j = 0;
    while i < len(x) {
        var other = 0;
        if len(y) > 0 {
            other = int_of(y[j]);
            j = j + 1;
            if j == len(y) {
                j = 0;
            }
        }
        diff = diff + (int_of(x[i]) ^ other);
        i = i + 1;
    }
    return diff == 0;
}

// Let a request through to the handler of `op`, or answer it. The answer is (`out`, true) for a request that may go on, and the
// 401 or 403 appended to `out` with false for one that may not. An operation the document lists no alternative for is open, as the
// document says. See §11.3 for what each answer means.
pub fn guard[&h, &r, &k, &q, &t](heap: &!h Heap, api: &r Api, tokens: &k Tokens, request: &q [byte], table: &t [int], op: int, out: buffer.Buffer, keep: bool) -> [heap] (buffer.Buffer, bool) {
    if requirements(api, op) == 0 {
        return (out, true);
    }
    let secret = bearer(request, table);
    if len(secret) == 0 {
        return (unauthorized(heap, out, keep, false), false);
    }
    var matched = false;
    var allowed = false;
    var i = 0;
    while i < vec.size(tokens.ents) {
        let at = vec.get(tokens.ents, i);
        let n = vec.get(tokens.ents, i + 1);
        let sat = vec.get(tokens.ents, i + 2);
        let sn = vec.get(tokens.ents, i + 3);
        let mine = same_secret(secret, buffer.bytes(tokens.text)[sat..sat + sn]);
        if mine {
            matched = true;
            if lists_scheme(api, op, buffer.bytes(tokens.text)[at..at + n]) {
                allowed = true;
            }
        }
        i = i + 4;
    }
    if allowed {
        return (out, true);
    }
    if matched {
        return (forbidden(heap, out, keep), false);
    }
    return (unauthorized(heap, out, keep, true), false);
}

// One access-log line: `METHOD path status milliseconds` and a newline. `response` is what was answered (its status line is
// read); the query string is left out because it is where secrets get put; the path is cut at 200 bytes. The application writes the
// line (`err_write`) and times the request (`Clock`), so both stay in its own signature.
pub fn log_line[&h, &q, &t, &r](heap: &!h Heap, request: &q [byte], table: &t [int], response: &r [byte], millis: int) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 96), http.method(request, table));
    b = buffer.append(heap, b, " ");
    let path = http.path(request, table);
    if len(path) > 200 {
        b = buffer.append(heap, b, path[0..200]);
    } else {
        b = buffer.append(heap, b, path);
    }
    b = buffer.append(heap, b, " ");
    var status = 0;
    if len(response) >= 12 {
        status = (int_of(response[9]) - 48) * 100 + (int_of(response[10]) - 48) * 10 + (int_of(response[11]) - 48);
    }
    b = buffer.push_nat(heap, b, status);
    b = buffer.append(heap, b, " ");
    b = buffer.push_nat(heap, b, millis);
    return buffer.append(heap, b, "ms\n");
}
